{% set item_options = item_form.vars.collection_options|default([]) %}
{% set item_autosave_url = item_options.autosave_url|default(autosave_url) %}
{% set item_autosave_method = item_options.autosave_method|default(autosave_method) %}
<section
    class="custom-collection__item card {{ item_options.row_class|default('') }}"
    {% if item_autosave_url %}
        data-autosave-url="{{ item_autosave_url }}"
        {% if item_options.autosave_create_url|default(null) %}data-autosave-create-url="{{ item_options.autosave_create_url }}"{% endif %}
        {% if item_options.autosave_delete_url|default(null) %}data-autosave-delete-url="{{ item_options.autosave_delete_url }}"{% endif %}
        {% if item_options.autosave_id_field|default(null) %}data-autosave-id-field="{{ item_options.autosave_id_field }}"{% endif %}
        {% if item_options.autosave_key_field|default(null) %}data-autosave-key-field="{{ item_options.autosave_key_field }}"{% endif %}
        data-autosave-method="{{ item_autosave_method }}"
        data-autosave-prefix="{{ item_form.vars.full_name }}"
        {% if item_options.id|default(null) is not null %}data-autosave-id="{{ item_options.id }}"{% endif %}
    {% endif %}
>
    <header class="card-header d-flex align-items-center gap-2">
        {% if editable_order %}
            <button type="button" class="btn-app btn-sm btn-app-icon movable" draggable="true" title="Drag to reorder" aria-label="Drag to reorder">&#x2630;</button>
        {% endif %}
        <span class="custom-collection__number flex-grow-1" data-nando-jans--form-tools--collection-target="number"></span>
        <span class="custom-collection__autosave-status small text-body-secondary" aria-live="polite"></span>
        {% if editable_order %}
            <button type="button" class="btn-app btn-sm btn-app-icon" title="Move up" aria-label="Move up" data-action="nando-jans--form-tools--collection#moveUp">
                <i class="fa fa-arrow-up"></i>
            </button>
            <button type="button" class="btn-app btn-sm btn-app-icon" title="Move down" aria-label="Move down" data-action="nando-jans--form-tools--collection#moveDown">
                <i class="fa fa-arrow-down"></i>
            </button>
        {% endif %}
        {% if allow_delete %}
            <button type="button" class="btn-app btn-sm btn-app-icon text-danger" data-action="nando-jans--form-tools--collection#remove">
                <i class="fa fa-trash"></i>
            </button>
        {% endif %}
    </header>
    <div class="card-body" data-nando-jans--form-tools--collection-target="body">{{ form_widget(item_form) }}</div>
</section>
