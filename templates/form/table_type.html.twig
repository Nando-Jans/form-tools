{% if rows is empty %}
    <p class="text-muted">{{ empty_message }}</p>
{% else %}
    <table
            class="table table-striped table-hover w-100"
            {{ stimulus_controller('@nando-jans/form-tools/table') }}
            data-click-url="{{ click_url }}"
    >
        <thead class="thead-light">
            <tr>
            {% for col in cols %}
                <th scope="col">{{ col }}</th>
            {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for row in rows %}
                <tr
                        class="{{ tr_class }}"
                        data-id="{{ row.id }}"
                        {{ stimulus_action(
                            '@nando-jans/form-tools/table',
                            'onClickTr',
                            'click'
                        ) }}
                >
                    {% for col in colKeys %}
                        <td>
                            {{ row[col] }}
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}