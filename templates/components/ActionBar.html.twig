<div
    class="action-bar card z-3 position-fixed bottom-0 start-50 m-3 p-2"
    {{ attributes.defaults({
        'data-controller': 'nando-jans--form-tools--action-bar',
        'data-action': 'form-tools:action-bar:undo-button-enabled@window->nando-jans--form-tools--action-bar#undoButtonEnabled'
    }) }}
>
    <button
            type="button"
            data-target="nando-jans--form-tools--action-bar.undoButton"
            data-action="click->nando-jans--form-tools--action-bar#undo"
            class="btn-app btn-app-icon"
            disabled
    >
        <i class="fa fa-undo"></i>
    </button>
</div>
